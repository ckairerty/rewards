# ------------------------------------------------------------------ #
#  TIMING — mixed distributions, not just Gaussian                    #
# ------------------------------------------------------------------ #

def gauss_delay(mean, sigma, min_val=0.05):
    return max(min_val, random.gauss(mean, sigma))


def pareto_delay(min_val, shape=1.5):
    """Heavy-tailed — occasionally very long pauses like a distracted human."""
    return min_val * random.paretovariate(shape)


def exp_delay(mean, min_val=0.05):
    """Exponential — short bursts with rare long gaps."""
    return max(min_val, random.expovariate(1.0 / mean))


def human_delay(mean, sigma, min_val=0.05):
    """
    Randomly picks a distribution per call.
    Humans aren't consistently Gaussian — sometimes fast,
    sometimes randomly long, never perfectly bell-curved.
    """
    roll = random.random()
    if roll < 0.65:
        return gauss_delay(mean, sigma, min_val)
    elif roll < 0.85:
        return exp_delay(mean, min_val)
    else:
        return min(pareto_delay(mean * 0.5), mean * 6)


